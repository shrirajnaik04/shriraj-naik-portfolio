{
  "name": "shriraj-naik-portfolio",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "test:e2e": "playwright test --project=chromium-desktop --project=chromium-mobile --project=firefox-desktop --project=webkit-mobile",
    "test:visual": "playwright test --project=visual",
    "resume:verify": "vitest run tests/resume",
    "assets:build": "tsx scripts/assets/build.ts",
    "perf": "pnpm build && node scripts/perf/run.mjs",
    "audit:deps": "osv-scanner scan source --config=osv-scanner.toml --lockfile=pnpm-lock.yaml && pnpm audit --prod --audit-level=low",
    "audit:secrets": "gitleaks git --redact --no-banner",
    "harness": "pnpm verify && pnpm test:e2e && pnpm test:visual && pnpm resume:verify && pnpm perf && pnpm audit:deps && pnpm audit:secrets",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
